# Copy this file to `.env` in the repo root. Do not commit `.env`.

# Database
DATABASE_URL=postgresql+asyncpg://ops:ops@localhost:5434/ops_copilot
DATABASE_URL_SYNC=postgresql+psycopg://ops:ops@localhost:5434/ops_copilot

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ops-copilot

# App
API_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
